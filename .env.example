# UrduFlow Frontend Environment Configuration

# API Endpoint Configuration
# Default: http://localhost:8000
# For production, set to your deployed FastAPI backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Recording Settings (in milliseconds)
# Maximum recording duration before auto-stop
# Default: 60000 (60 seconds)
# NEXT_PUBLIC_MAX_RECORDING_DURATION=60000

# Development Settings
# Uncomment to enable debug logging
# NEXT_PUBLIC_DEBUG=true
